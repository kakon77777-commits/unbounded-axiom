{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RH GAP Record",
  "type": "object",
  "required": [
    "id", "route", "title", "gap_types", "severity", "status",
    "source_node", "target_node", "obligation", "verification"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^RH-[A-Z]+-[0-9]{2}$"},
    "route": {"type": "string"},
    "title": {"type": "string"},
    "gap_types": {
      "type": "array",
      "items": {"type": "string", "pattern": "^G-[A-Z]{3}$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "severity": {"enum": ["S0", "S1", "S2", "S3", "S1-S2"]},
    "status": {
      "enum": [
        "KNOWN", "FILLED", "PROVISIONAL", "OPEN", "BLOCKED",
        "EQUIVALENT_RISK", "CIRCULAR", "REFUTED",
        "NOT_FORMALIZED", "CERTIFIED_NUMERICAL", "EXPERIMENTAL"
      ]
    },
    "source_node": {"type": "string"},
    "target_node": {"type": "string"},
    "obligation": {"type": "string"},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "failure_witness": {"type": "string"},
    "verification": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "equivalent_risk": {"type": "boolean"},
    "circularity_checked": {"type": "boolean"},
    "notes": {"type": "string"}
  }
}
