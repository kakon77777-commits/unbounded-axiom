# Continuous Discovery Beacon integration (scripts/notify_beacon.py, called
# from deploy.sh after a verified deploy). This is logic.evemisslab.com's
# OWN scoped token from https://beacon.evemiss.com/api/v1/sites — it can
# only submit events for this one site, never anything else.
# Copy this file to .env.local (gitignored) and fill in the real value,
# then `export $(grep -v '^#' .env.local | xargs)` before running deploy.sh
# — or just `export BEACON_SUBMIT_TOKEN_LOGIC=...` directly in your shell.
BEACON_SUBMIT_TOKEN_LOGIC=
