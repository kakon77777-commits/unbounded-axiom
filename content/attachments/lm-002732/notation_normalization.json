{
  "schema": "JDPSP-NOTATION-NORMALIZATION-0.1",
  "changes": [
    {
      "old": "r as reference scope",
      "new": "rho",
      "reason": "avoid collision with probability-order notation"
    },
    {
      "old": "r as probability order",
      "new": "k",
      "reason": "global Series I notation normalization"
    },
    {
      "old": "P>1 as probability overflow",
      "new": "finite mass/intensity mu with M=mu(X)>1",
      "reason": "ordinary probability remains normalized"
    },
    {
      "old": "P<0 as negative event probability",
      "new": "signed measure or quasiprobability",
      "reason": "type integrity"
    },
    {
      "old": "Superprobability as formal English name",
      "new": "Unified Judgment-Domain Probability Framework",
      "reason": "Superprobability already has established supersymmetric-probability usage"
    }
  ]
}