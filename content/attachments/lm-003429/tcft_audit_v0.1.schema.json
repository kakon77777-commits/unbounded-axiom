    "frontier_status": {
      "enum": [
        "NORMAL",
        "UNCOMMON",
        "RARE",
        "EXTREME",
        "HISTORICAL_FRONTIER_CANDIDATE",
        "PERSISTENT_FRONTIER_CANDIDATE",
        "UNRESOLVED"
      ]
    },
    "time_layers": {
