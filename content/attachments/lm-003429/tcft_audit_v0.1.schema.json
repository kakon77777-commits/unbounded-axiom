              ]
            },
            "normalized_score": {
              "type": [
                "number",
                "null"
              ]
            },
            "confidence": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "status": {
              "enum": [
                "MEASURED",
                "EXPERIMENTAL",
                "UNRESOLVED",
                "NOT_APPLICABLE"
              ]
            },
            "metric_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "warnings": {
